{
  "name": "houdini-pi",
  "private": true,
  "version": "0.1.0",
  "description": "An in-Houdini chat agent built on pi",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "protocol",
    "sidecar",
    "pi",
    "ui"
  ],
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:py": "uv run --with pytest pytest houdini/tests tests",
    "typecheck": "tsc -b protocol pi sidecar",
    "build": "npm run build -w protocol && npm run build -w ui && npm run build -w sidecar",
    "check-pi": "vitest run sidecar/test/pi-surface.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
