{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist-types",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "types": [
      "node"
    ],
    "paths": {
      "@houdini-pi/protocol": [
        "../protocol/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts"
  ]
}
