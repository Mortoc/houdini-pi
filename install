#!/bin/sh
# Install houdini-pi into this user's Houdini.
#
#   ./install              # check requirements, build, write the package JSON
#   ./install --uninstall  # remove the package file the installer wrote
#   ./install --check      # requirements check only, no build, no write
#
# Plain sh on purpose: it has to run, and say what is missing, on a machine
# that has none of the requirements yet. It uses only shell builtins. Once the
# requirements pass, scripts/install.py does the rest under uv.

set -u

NODE_MIN="22 19 0"
# The first pi release with built-in MCP (`builtin:mcp`), which the sidecar relies on.
PI_MIN="1 0 0"

case $0 in
  */*) ROOT=$(cd "${0%/*}" && pwd) ;;
  *) ROOT=$(pwd) ;;
esac

mode=install
for arg in "$@"; do
  case $arg in
    --check) mode=check ;;
    --uninstall) mode=uninstall ;;
    -h | --help)
      sed -n '2,6s/^# \{0,1\}//p' "$0" 2>/dev/null || echo "usage: ./install [--check | --uninstall]"
      exit 0
      ;;
    *)
      echo "install: unknown option '$arg'. Usage: ./install [--check | --uninstall]" >&2
      exit 2
      ;;
  esac
done

# "major minor patch" from the first dotted number in $1; fails when there is none.
parse_version() {
  v=${1#"${1%%[0-9]*}"}
  v=${v%%[!0-9.]*}
  [ -n "$v" ] || return 1
  old_ifs=$IFS
  IFS=.
  # shellcheck disable=SC2086 # split on dots
  set -- $v
  IFS=$old_ifs
  echo "${1:-0} ${2:-0} ${3:-0}"
}

# version_at_least "22 23 3" "22 19 0"
version_at_least() {
  # shellcheck disable=SC2086 # split on spaces
  set -- $1 $2
  [ "$1" -gt "$4" ] && return 0
  [ "$1" -lt "$4" ] && return 1
  [ "$2" -gt "$5" ] && return 0
  [ "$2" -lt "$5" ] && return 1
  [ "$3" -ge "$6" ]
}

dotted() {
  # shellcheck disable=SC2086 # split on spaces
  set -- $1
  echo "$1.$2.$3"
}

missing=0
pass() { printf '  \342\234\223 %-12s %s\n' "$1" "$2"; }
fail() {
  missing=$((missing + 1))
  printf '  \342\234\227 %-12s %s\n' "$1" "$2"
  shift 2
  for line in "$@"; do printf '                   %s\n' "$line"; done
}

# A tool installed to a usual place that this shell's PATH has not picked up yet.
installed_off_path() {
  for dir in "$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/.npm-global/bin"; do
    if [ -x "$dir/$1" ]; then
      echo "$dir/$1"
      return 0
    fi
  done
  return 1
}

not_found() {
  name=$1
  shift
  if found=$(installed_off_path "$name"); then
    fail "$name" "installed at $found but not on PATH" \
      "Open a new terminal, or add ${found%/*} to PATH."
  else
    fail "$name" "not found" "$@"
  fi
}

check_versioned() {
  name=$1 minimum=$2
  shift 2
  if ! command -v "$name" >/dev/null 2>&1; then
    not_found "$name" "$@"
    return
  fi
  if ! found=$(parse_version "$("$name" --version 2>/dev/null)"); then
    fail "$name" "could not read '$name --version'" "$@"
  elif version_at_least "$found" "$minimum"; then
    pass "$name" "$(dotted "$found")"
  else
    fail "$name" "found $(dotted "$found"), need $(dotted "$minimum") or newer" "$@"
  fi
}

check_present() {
  name=$1
  shift
  if command -v "$name" >/dev/null 2>&1; then
    pass "$name" "$(command -v "$name")"
  else
    not_found "$name" "$@"
  fi
}

echo "houdini-pi requirements"

check_present uv \
  "uv runs this installer and the fxhoudinimcp MCP server." \
  "Install it: curl -LsSf https://astral.sh/uv/install.sh | sh" \
  "(more options: https://docs.astral.sh/uv/getting-started/installation/)"

if [ "$mode" != uninstall ]; then
  if command -v uv >/dev/null 2>&1; then
    check_present uvx "uvx ships with uv; reinstall uv to get it back."
  fi
  check_versioned node "$NODE_MIN" \
    "Node runs the sidecar. Install Node $(dotted "$NODE_MIN")+ from https://nodejs.org" \
    "(or with nvm: nvm install 22)"
  check_present npm "npm ships with Node; reinstall Node to get it back."
  check_versioned pi "$PI_MIN" \
    "pi is the agent the pane talks to. Install or update it:" \
    "curl -fsSL https://pi.dev/install.sh | sh"
fi

check_present hython \
  "hython comes with Houdini but is not on PATH. Run from a Houdini shell, or:" \
  "cd /opt/hfs22.0 && source houdini_setup"

if [ "$missing" -gt 0 ]; then
  [ "$missing" -eq 1 ] && what="1 requirement is" || what="$missing requirements are"
  echo
  echo "install: $what missing or too old. Fix the above, then run ./install again." >&2
  exit 1
fi

[ "$mode" = check ] && exit 0

if [ "$mode" = uninstall ]; then
  exec uv run --script "$ROOT/scripts/install.py" --uninstall
fi
exec uv run --script "$ROOT/scripts/install.py"
